# Required. The SEC rejects requests without a contact string and will return
# 403 for everything until this is set.
EDGAR_USER_AGENT=Your Name your.email@example.com

# Requests per second. SEC's published ceiling is 10; the default sits under it.
RATE_LIMIT=9

# Worker threads. They share one global rate limiter, so raising this changes
# how well latency is hidden, not the outbound request rate.
WORKERS=6

CACHE_DIR=.cache
OUT_DIR=out
